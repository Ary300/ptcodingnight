# Copy to .env and adjust. G10 requires a cold start with no manual steps beyond this copy.
# Never commit .env — it is gitignored.

# --- Database -------------------------------------------------------------
# Host/port match the `postgres` service in docker-compose.yml. From inside another
# compose service, replace localhost with `postgres`.
# Credentials for the containers docker-compose starts. CHANGE BOTH before a real deployment —
# these are placeholders, and until this file said so they were live credentials on a LAN-published
# port. The data services now bind to 127.0.0.1 as well, so both have to be wrong for it to matter.
POSTGRES_PASSWORD="ptcn_dev_password"
REDIS_PASSWORD="ptcn_dev_redis"

DATABASE_URL="postgresql://ptcn:ptcn_dev_password@localhost:5432/ptcn?schema=public"

# --- Queue ----------------------------------------------------------------
# From inside another compose service, replace localhost with `redis`.
REDIS_URL="redis://localhost:6379"

# --- Auth -----------------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -hex 32
# Required in production; a dev/test run falls back to an ephemeral secret, which means
# everyone is logged out when the process restarts.
SESSION_SECRET="change-me-to-32-plus-random-characters-abcdef"
# Shared passcode for the organizer console.
ADMIN_PASSCODE="change-me-before-the-night"

# --- Judge ----------------------------------------------------------------
# Root for test-case files on disk. TestCase rows store paths relative to this.
TEST_DATA_ROOT="./data/testcases"
# Judge worker concurrency. G8 targets 40 concurrent submissions.
JUDGE_CONCURRENCY="4"
# Pinned runtime images. Pulled once; the contest night has no internet.
JUDGE_IMAGE_PYTHON="python:3.12-slim"
JUDGE_IMAGE_JAVA="eclipse-temurin:21-jdk"
# Per-container resource caps. Wall-clock kill is computed as 3x the problem time limit.
JUDGE_MEMORY_LIMIT="256m"
JUDGE_CPU_LIMIT="1.0"
JUDGE_PIDS_LIMIT="64"
JUDGE_TMPFS_SIZE="16m"

# --- Web ------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Park Tudor Coding Night"

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
# How many trusted proxies sit in front of the app. 0 means none, which is the shipped
# deployment — docker-compose publishes the web service directly.
#
# While this is 0, `x-forwarded-for` is IGNORED. That is deliberate: the header is
# attacker-controlled without a proxy in front, and trusting it made every rate limiter
# defeatable with a random value per request. Set this only if you actually put a proxy
# in front, and set it to the number of hops you control.
TRUSTED_PROXY_COUNT="0"

# ---------------------------------------------------------------------------
# OAuth (optional)
# ---------------------------------------------------------------------------
# Leave blank to turn a provider off — its route then answers "not configured on this
# server" rather than failing mid-flow in a way that reads like the student's mistake.
#
# Neither provider can create an account: User.passwordHash is NOT NULL, so an
# OAuth-only account is unrepresentable. See docs/AUTH.md §3.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Must match the redirect URI registered with each provider EXACTLY, including the port.
# A mismatch is the most common OAuth setup failure and the providers' error messages for
# it are famously unhelpful.
PUBLIC_ORIGIN="http://localhost:3000"

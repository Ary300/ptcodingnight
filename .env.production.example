# Production environment for ptcodingnight.com.
#
#   cp .env.production.example .env      (on the server, NOT in git)
#
# Every value below is either a secret you generate on the server or a setting that must match
# the deployment. NOTHING here is a working default — a placeholder that runs is a placeholder
# that ships.
#
# The exact generation command is next to each secret. Run it on the server and paste the
# output; do not reuse a value from a chat window, a laptop, or this file's history.
#
# docs/DEPLOY.md walks through all of it in order.

# ---------------------------------------------------------------------------
# Secrets — generate every one of these. Do not copy them from anywhere.
# ---------------------------------------------------------------------------

# Postgres password. Nothing outside the compose network can reach Postgres (it publishes no
# port at all), so this is defence in depth rather than the only control — which is not a
# reason to make it guessable.
#
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Redis password. Redis holds the JUDGE QUEUE, and a hand-pushed job on that queue is arbitrary
# work on the judge host — this is not a cache password (SECURITY.md C1).
#
#   openssl rand -base64 32
REDIS_PASSWORD=

# Signs nothing and identifies everything: the session cookie carries an opaque token, and this
# key is what makes a JOIN CLAIM unforgeable. Without it a student could paste another
# participant's id into a cookie and become them (docs/AUTH.md §5.4).
#
# Changing it signs everyone out and invalidates every join claim. Do not rotate it mid-contest.
#
#   openssl rand -hex 32
SESSION_SECRET=

# The organizer console passcode. A HUMAN types this, so it is the one secret here that is not
# random — make it long rather than clever. Four unrelated words beats "P@ssw0rd!".
#
# Guessing is bounded by a growing delay rather than a lockout, deliberately: a hard limit would
# let a student burn the organizer's attempts on purpose and lock the console mid-contest
# (SECURITY.md H4).
ADMIN_PASSCODE=

# ---------------------------------------------------------------------------
# Deployment identity
# ---------------------------------------------------------------------------

# MUST match the certificate and the OAuth redirect URIs exactly, including the scheme and with
# no trailing slash. Production refuses to start if this is not https:// while a provider is
# configured, because an http:// origin there means either TLS is not really terminated or the
# redirect URI will not match — and providers' error messages for a mismatch are famously
# unhelpful.
PUBLIC_ORIGIN=https://ptcodingnight.com

# The ACME account contact. Certificate-expiry warnings go here. A real address someone reads.
ACME_EMAIL=

# ---------------------------------------------------------------------------
# Judge
# ---------------------------------------------------------------------------

# The host directory the judge works in. THIS PATH IS MOUNTED AT THE SAME PATH INSIDE THE
# WORKER CONTAINER, and that is not tidiness — it is required.
#
# The worker asks the HOST Docker daemon to bind-mount scratch directories into each judge
# container, and the host resolves those paths in its own namespace. A container-local path like
# /app/.judge-tmp resolves on the host to a directory that does not exist, the judge container
# gets a silently EMPTY mount, and every submission fails with no visible cause.
#
# Only the judge SCRATCH lives here. The authored test data is baked into the worker image, and
# is read by the worker process rather than mounted into a judge container, so it needs no
# host path at all.
#
# Create it before the first `up`:  sudo mkdir -p /srv/ptcn/judge && sudo chown -R $USER /srv/ptcn
JUDGE_HOST_ROOT=/srv/ptcn/judge

# How many submissions judge at once. TWO on a 2 vCPU / 4 GB droplet: each judge container is
# capped at JUDGE_MEMORY_LIMIT and the services already hold roughly 1.9 GB of the 4.
#
# Raise this AFTER a contest-night resize, not before — see docs/DEPLOY.md §9.
JUDGE_CONCURRENCY=2

# Per-judge-container caps. These bound a student's program, not the compiler; compile limits
# are separate and live in lib/judge/runtimes.ts per runtime.
JUDGE_MEMORY_LIMIT=256m
JUDGE_CPU_LIMIT=1.0
JUDGE_PIDS_LIMIT=64
JUDGE_TMPFS_SIZE=16m

# Pinned runtime images. Pinned rather than floating so a contest never judges against a tag
# that moved underneath it. `scripts/build-judge-images.sh --verify` pulls these and BUILDS
# ptcn-go:1.23, which is not on any registry — run it before the night.
JUDGE_IMAGE_PYTHON=python:3.12-slim
JUDGE_IMAGE_JAVA=eclipse-temurin:21-jdk

# ---------------------------------------------------------------------------
# OAuth — optional, and off is a valid answer
# ---------------------------------------------------------------------------
# Leave a provider blank to turn it off. Its route then answers "not configured on this server"
# rather than failing mid-flow in a way that reads like the student's mistake.
#
# Neither provider can CREATE an account: User.passwordHash is NOT NULL, so an OAuth-only
# account is unrepresentable (docs/AUTH.md §3). The join code is always a way in.
#
# The redirect URIs to register are in docs/DEPLOY.md §7. They must match to the character.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Things you should NOT set here
# ---------------------------------------------------------------------------
# COOKIE_SECURE          — defaults to true, and production refuses to start if it is false.
#                          Setting it to false on a public host is a session token handed to
#                          anything on the network path.
# TRUSTED_PROXY_COUNT    — set to 1 by docker-compose.prod.yml, because Caddy is the one proxy
#                          in front. Setting it higher trusts hops that do not exist, and
#                          x-forwarded-for is attacker-controlled input past the last real one.
# NEXT_PUBLIC_CONTEST_BACKEND — unset means the REAL API. Set it to "stub" only to demo the
#                          screens against invented data; every screen then says so.

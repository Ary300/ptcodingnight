import { chromium } from "@playwright/test";
const TOKEN = process.env.TOK;
const OUT = process.env.OUT;
const b = await chromium.launch();
const ctx = await b.newContext({ viewport: { width: 1440, height: 1000 }, deviceScaleFactor: 2 });
await ctx.addCookies([{ name: "ptcn_session", value: TOKEN, domain: "localhost", path: "/", httpOnly: true, sameSite: "Lax", secure: false }]);
const page = await ctx.newPage();
const errs = [];
page.on("console", (m) => { if (m.type() === "error") errs.push(m.text()); });
page.on("pageerror", (e) => errs.push("PAGEERROR " + e.message));

async function shot(url, name, w, h) {
  await page.setViewportSize({ width: w, height: h });
  await page.goto("http://localhost:3000" + url, { waitUntil: "networkidle" });
  await page.waitForTimeout(1200);
  const doc = await page.evaluate(() => ({ sw: document.documentElement.scrollWidth, cw: document.documentElement.clientWidth, title: document.title, body: document.body.innerText.slice(0, 400) }));
  await page.screenshot({ path: `${OUT}/${name}.png`, fullPage: true });
  console.log(JSON.stringify({ name, url, w, overflow: doc.sw > doc.cw ? `${doc.sw} > ${doc.cw}` : "none", body: doc.body }, null, 1));
}
const targets = JSON.parse(process.env.TARGETS);
for (const t of targets) { await shot(t.url, t.name, t.w, t.h); }
console.log("CONSOLE ERRORS:", JSON.stringify(errs, null, 1));
await b.close();

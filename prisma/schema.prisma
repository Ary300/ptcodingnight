// Park Tudor Coding Night — domain model.
// Spec of record: docs/PRD.md §5. Do not add fields here without updating that section.
//
// Two rules this schema is shaped by:
//   1. Standings must be replayable. Nothing here stores a running total that cannot be
//      re-derived from the Submission log by lib/scoring/. `Standing` is a cache, never a
//      source of truth.
//   2. Test data lives as files on disk, referenced by path — not as DB blobs (PRD §5).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and reaches the
// client via a driver adapter. It is no longer declared here.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  COMPETITOR
  ADMIN
}

/// How a session was established.
///
/// Recorded per session so "who was signed in, and how" is answerable after the fact, and so
/// the "Google is never the only way in" rule is auditable rather than merely intended.
enum AuthMethod {
  /// Competitor typed a contest join code. The primary competitor path; needs no internet.
  JOIN_CODE
  /// Organizer typed the shared passcode from the environment. The night's fallback.
  ADMIN_PASSCODE
  /// Organizer signed in with an admin-issued email + password held in User.passwordHash.
  ADMIN_PASSWORD
  /// Optional convenience, and ONLY ever a second way into an account that already has a local
  /// credential — see User.passwordHash.
  GOOGLE
  /// Same contract as GOOGLE.
  GITHUB
}

enum ContestState {
  DRAFT
  SCHEDULED
  RUNNING
  FROZEN
  ENDED
  ARCHIVED
}

/// E = 100, M = 200, H = 300 base points by default (PRD §6.1, organizer-editable
/// per ContestProblem).
enum Difficulty {
  E
  M
  H
}

/// A language a student may pick. One entry per VARIANT in lib/judge/runtimes.ts, not per
/// runtime: Java's four levels share one JDK 21 image and C++11/C++17/C17 share one GCC image,
/// but each is a separate choice with different compile flags and so a separate value here.
///
/// Adding C++20 or Rust means a value here, a migration, and a line in VARIANTS — never a
/// change to worker/runner.ts.
enum Language {
  PYTHON_312
  JAVA_8
  JAVA_11
  JAVA_17
  JAVA_21
  C_17
  CPP_11
  CPP_17
  JAVASCRIPT_NODE22
  GO_123
}

/// PRD §7.2. `IE` is never shown to a student as a failure — requeue once, then alert
/// admin.
enum Verdict {
  AC
  WA
  TLE
  MLE
  RE
  CE
  IE
}

/// A problem cannot enter a live contest while in DRAFT. Enforced in the API, not just
/// the UI (PRD §8).
enum ProblemState {
  DRAFT
  PUBLISHED
  RETIRED
}

/// Mirrors the `type` column of data/problems_seed.csv.
/// Which round a contest problem belongs to. The rounds score differently: an INDIVIDUAL
/// problem is solved by one player on their assigned set, a GROUP problem is solved once by the
/// whole team. Both feed the same per-player pool before the mean (docs/SCORING.md §1).
enum ProblemRound {
  INDIVIDUAL
  GROUP
}

/// How players are matched to problem sets. Both formats the organizer described are supported.
enum SetSelection {
  /// Default. Seeded, balanced random assignment per player. No preview and no choice.
  RANDOM_ASSIGNED
  /// Each player picks their own set independently.
  PLAYER_CHOOSES
  /// The whole team works a single set.
  ONE_SET_PER_TEAM
}

enum ProblemType {
  ALGORITHM
  CODINGBAT
  GROUP
}

/// Mirrors the `past_status` column of data/problems_seed.csv. Surfaced in the problem
/// picker so organizers stop re-picking problems nobody could solve (PRD §8).
enum PastStatus {
  HINT_CURRENCY
  USED_IN_CONTEST
  SOLVED_IN_PAST
  CANDIDATE_UNUSED
  USED_BUT_ZERO_POINTS
  GROUP_PROBLEM
  PARTIALLY_SOLVED_IN_PAST
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id          String    @id @default(cuid())
  email       String?   @unique
  displayName String
  role        Role      @default(COMPETITOR)
  gradYear    Int?
  createdAt   DateTime  @default(now())
  disabledAt  DateTime?

  /// Scrypt hash of a password. NULL for a student who signed up with Google or GitHub.
  ///
  /// ## This column used to be NOT NULL, and half of that invariant is still enforced
  ///
  /// The original rule was "no account may be reachable ONLY through an OAuth provider", made
  /// unrepresentable rather than merely tested. The reasoning was never the venue — internet is
  /// guaranteed (PRD §10.1) — it was OAuth's own failure modes: an expired client secret, a
  /// changed consent screen, a provider having an afternoon.
  ///
  /// Students now sign up with Google or GitHub and have no password to store, so the column has
  /// to admit NULL. But the reasoning above is not equally true of both roles:
  ///
  ///   - A COMPETITOR locked out by an OAuth outage is an organizer's problem to solve for one
  ///     student, and the join code is still there as break-glass.
  ///   - An ADMIN locked out by an OAuth outage is a contest that cannot be started, frozen,
  ///     unfrozen or exported, with a room full of people waiting.
  ///
  /// So the guarantee is kept exactly where it carries weight, as a CHECK constraint in
  /// `20260801020000_oauth_signup`:
  ///
  ///     role <> 'ADMIN' OR "passwordHash" IS NOT NULL
  ///
  /// **An OAuth-only ADMIN is still unrepresentable in this schema.** A future code path that
  /// tries to create one fails at the database rather than succeeding quietly, which is the
  /// property the NOT NULL was really buying.
  passwordHash String?

  /// Google's stable subject claim (`sub`), if linked. Never an email: emails get reassigned
  /// between people, `sub` does not.
  googleSub String? @unique

  /// GitHub's numeric account id, if linked. Same reasoning as googleSub — a GitHub *username*
  /// is renameable and reusable, the id is not.
  githubSub String? @unique

  /// A profile picture the student uploaded from Settings, stored as raw bytes.
  ///
  /// In the row rather than on disk or in object storage on purpose: this app already keeps its
  /// state in one Postgres it can back up and restore atomically, and an avatar that lives
  /// somewhere else is a second thing that can be missing after a restore. The images are small
  /// and capped (see `AVATAR_MAX_BYTES`), and this column is NEVER selected by the hot paths —
  /// only the dedicated avatar route reads it, so a `SELECT *` on User does not drag a picture
  /// into every session lookup.
  avatarData      Bytes?
  /// The image's MIME type, so the serving route sends the right `Content-Type`. Constrained to a
  /// small allow-list at the write boundary, never trusted from the upload.
  avatarMime      String?
  /// When the avatar last changed, used to bust the browser cache on the `<img>` URL — without it
  /// a new picture would not show until the cached one expired.
  avatarUpdatedAt DateTime?

  participants Participant[]
  sessions     Session[]

  @@index([role])
}

/// A server-side session. **The cookie is a pointer, not a credential.**
///
/// Previously the cookie WAS the session: a signed claims blob with no server-side record, so
/// there was no way to revoke one before it expired and no way to answer "who is signed in".
/// Both matter mid-contest — an organizer must be able to cut off a session that is being
/// misused while the round is still running.
///
/// Rows survive a web or worker restart because they are in Postgres, which is the other half
/// of the requirement: a redeploy mid-contest must not sign 40 students out.
model Session {
  id String @id @default(cuid())

  /// SHA-256 of the cookie token, never the token. A database dump therefore yields no usable
  /// sessions — the same reason passwords are not stored in the clear.
  tokenHash String @unique

  role          Role
  method        AuthMethod
  /// Set for a competitor session; null for an organizer.
  participantId String?
  contestId     String?
  /// Set when the session belongs to a User account (organizer sign-in). Null for join-by-code,
  /// which deliberately has no account behind it.
  userId        String?
  displayName   String

  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  /// Non-null means revoked. Kept rather than deleted so the audit trail survives the
  /// revocation, and so "why am I signed out" has an answer.
  revokedAt     DateTime?
  revokedReason String?

  participant Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Contest structure
// ---------------------------------------------------------------------------

model Contest {
  id              String       @id @default(cuid())
  /// The permanent practice arena. Exactly one should exist; sign-in falls back to it when no
  /// real contest is open, the clock reconciler never starts or ends it, and the projector's
  /// default contest pick skips it. It is a real contest in every other way, which is the point:
  /// the lobby, the judge and the standings all just work.
  isPractice Boolean @default(false)
  name            String
  startsAt        DateTime
  endsAt          DateTime
  /// After this instant the public leaderboard stops updating while judging continues.
  /// Admin still sees live truth (PRD §6.3).
  freezeAt        DateTime?
  state           ContestState @default(DRAFT)
  /// Identifies the scoring preset in lib/scoring/ ("coding-night-classic" | "icpc").
  scoringPresetId String       @default("coding-night-classic")
  /// Admin-issued fallback sign-in path. Kept even though OAuth is available, because OAuth
  /// fails for reasons unrelated to the venue (PRD §10.1).
  joinCode        String       @unique

  // --- scoring config (docs/SCORING.md §4) --------------------------------
  /// Group problem points join the per-player pool BEFORE the mean. Organizer-confirmed default.
  /// False adds them to the team total after the mean, making them worth teamSize times as much.
  groupPointsInsideMean      Boolean      @default(true)
  /// Side activity points are added flat to the team total. Organizer-confirmed default.
  /// False sends them through the same divisor as everything else.
  sideActivitiesFlat         Boolean      @default(true)
  /// How players are matched to problem sets.
  setSelection               SetSelection @default(RANDOM_ASSIGNED)
  /// Whether a player may read a set they were not assigned. **Enforced in the API, not just the
  /// UI** — a set a competitor can read is a set they can practise on before their own round.
  allowReadingUnassignedSets Boolean      @default(false)

  /// When students stop being able to form and join teams. Null means "when the contest starts".
  ///
  /// The rule is that formation closes at `startsAt`: students arrive, form teams, then compete,
  /// and after the gun a roster change moves a divisor under a score that already exists. That
  /// default is what this column is null for.
  ///
  /// It is overridable because the default and "the contest is running" are not always the same
  /// thing — a relaxed session, a rehearsal, or the public demo all want formation open while
  /// submissions are also accepted. Without this the only way to get that is to edit the
  /// database, which is the exact problem team management exists to remove.
  teamFormationClosesAt DateTime?

  /// Largest team a student may join. An organizer's guardrail, not a scoring input.
  ///
  /// **Team size is the divisor**, so an oversized team is not merely untidy — it dilutes every
  /// member's contribution. Enforced when joining; an organizer can still place someone over the
  /// limit deliberately, because a roster correction on the night must not be blocked by a
  /// setting.
  maxTeamSize Int @default(4)

  /// Whether students may still create and join teams.
  ///
  /// Derived from `state` rather than stored as a second flag: team formation closes when the
  /// contest starts, and a stored boolean would be a second source of truth that drifts from the
  /// thing it describes — the same reason team size is never stored as a count.
  ///
  /// Seed for problem-set assignment. Stored so any assignment can be RE-DERIVED from the seed
  /// and the participant list: a disputed assignment has to be explainable rather than argued
  /// about (PRD §6.2). Null until Round 1 assignment runs.
  setAssignmentSeed String?

  /// The difficulty recipe one set is built to: `[{ difficulty, count, points? }, ...]`.
  ///
  /// STORED RATHER THAN HARDCODED because the format has changed between years. It has been one
  /// Easy, one Medium and one Hard, but it has also been two and four, and a constant in the code
  /// makes last year's contest unreproducible the moment this year's differs. Stored on the
  /// contest, so two contests in the same database may disagree about it.
  ///
  /// `Json` is `unknown` as far as Prisma is concerned, which makes this a TRUST BOUNDARY IN BOTH
  /// DIRECTIONS: it is Zod-parsed on the way in, and Zod-parsed again on the way out, because a
  /// row written by an older build is external data to the build reading it. Never cast.
  ///
  /// Null until an organizer plans the sets. A contest with no plan is the normal starting state.
  setComposition Json?

  /// How many sets the recipe was dealt into: the number of columns on the organizer's sheet.
  ///
  /// In practice the size of the largest team, since every member of a team holds a different set.
  /// Stored alongside the recipe because the two together are what `planSets` consumed, and either
  /// one alone cannot reproduce the deal.
  setCount Int?

  /// How many whole-team (GROUP) questions the plan deals after every division's sets are dealt.
  ///
  /// Part of the recipe, stored as its own column rather than inside `setComposition` so rows
  /// written before this existed keep parsing: absence of a value means zero team questions,
  /// which is exactly what those contests were built with.
  setGroupCount Int @default(0)

  /// Seed for the set BUILD: which problems landed in which set.
  ///
  /// Distinct from `setAssignmentSeed`, which decides which PLAYER holds which set. Two separate
  /// shuffles answering two separate questions, and sharing one column would mean re-planning the
  /// problems silently re-rolled every student's assignment.
  ///
  /// Stored for the same reason as the other seed: a disputed set has to be explainable rather
  /// than argued about (PRD §6.2). With the seed, the recipe and the bank, an organizer can
  /// re-derive the whole split in front of a room.
  setPlanSeed String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  divisions       Division[]
  contestProblems ContestProblem[]
  participants    Participant[]
  teams           Team[]
  problemSets     ProblemSet[]

  @@index([state])
}

/// A team. **The unit that gets ranked** (docs/SCORING.md).
///
/// Team size is the divisor in every team score, so a wrong roster is a wrong result — not a
/// cosmetic error. Members are Participants pointing here via teamId; size is therefore always
/// derived and never stored, because a stored count is a second source of truth that can drift
/// from the roster it claims to describe.
model Team {
  id        String @id @default(cuid())
  contestId String
  name      String

  /// The code teammates type to join this team.
  ///
  /// Scoped to the contest rather than globally unique: two contests may reuse a code without
  /// colliding, and the lookup is always `(contestId, joinCode)`. Short and unambiguous —
  /// generated from an alphabet with no O/0 or I/1, because it is read aloud across a room.
  joinCode String

  /// Who created it. Null for a team an organizer made directly, which is the distinction that
  /// matters when a roster is disputed: a student-made team has a student who chose the name.
  createdByParticipantId String?

  /// The division this team competes in, or null for a team open to anyone (the only kind that
  /// existed before divisions had their own teams). The standings tabs group teams by it, and a
  /// move onto a divisioned team adopts the team's division for the player unless the same
  /// request says otherwise. `SetNull`, so deleting a division opens its teams up rather than
  /// deleting rosters.
  divisionId String?

  createdAt DateTime @default(now())

  contest        Contest            @relation(fields: [contestId], references: [id], onDelete: Cascade)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  members        Participant[]
  sideActivities TeamSideActivity[]
  standings      Standing[]

  @@unique([contestId, name])
  @@unique([contestId, joinCode])
  @@index([contestId])
}

/// A parallel problem set for Round 1, labelled "A".."D".
///
/// Each set holds one Easy, one Medium and one Hard problem, and sets are calibrated to be of
/// equal difficulty — which is what makes a random assignment fair (PRD §5.1).
model ProblemSet {
  id        String @id @default(cuid())
  contestId String
  /// "A" | "B" | "C" | "D".
  label     String

  /// The division this set belongs to. Null for a contest with no divisions.
  ///
  /// When a contest has divisions, the planner deals each division its own columns, so
  /// "Intermediate A" and "Advanced A" are two different sets that happen to share a letter. A
  /// member is only ever handed a set of their own division; the letter alone stops identifying
  /// a set the moment divisions exist, which is why the unique key carries the division.
  ///
  /// The unique index is created NULLS NOT DISTINCT (Postgres 15+; the compose runs postgres:16),
  /// so two division-null sets cannot share a label either — the pre-division (contestId, label)
  /// semantics survive for contests that never split. Prisma cannot express that modifier, so the
  /// migration writes the index by hand under the name Prisma expects.
  ///
  /// Cascade rather than SetNull on the division: nulling would fold "Advanced A" into the
  /// null-division namespace, where a plain "A" may already exist, and NULLS NOT DISTINCT would
  /// then refuse the division delete with an error nobody can act on. A division's columns die
  /// with the division; Participant.chosenSetId is SetNull, so its members become visibly
  /// unassigned rather than silently mis-assigned.
  divisionId String?

  contest         Contest          @relation(fields: [contestId], references: [id], onDelete: Cascade)
  division        Division?        @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  contestProblems ContestProblem[]
  assignedTo      Participant[]

  @@unique([contestId, divisionId, label])
  @@index([contestId])
  @@index([divisionId])
}

/// Points awarded to a team for a non-coding activity — metal puzzle, train tracks, Connections.
///
/// **The only score input with no submission behind it**, which makes its audit trail the only
/// record that it happened at all. enteredBy and enteredAt are therefore not optional, and every
/// write also lands in AuditLog.
model TeamSideActivity {
  id     String @id @default(cuid())
  teamId String
  /// "Metal puzzle" | "Train tracks" | "Connections" | anything the organizer runs.
  label  String
  /// May be negative: an organizer correcting an over-award should not have to delete history.
  points Int

  /// Actor label of the admin who entered it. Never a display name alone — see actorLabel().
  enteredBy String
  enteredAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Division {
  id        String @id @default(cuid())
  contestId String
  /// "Intermediate" | "Advanced".
  ///
  /// **Optional now.** Teams replaced divisions as the primary ranking axis, and a contest that
  /// groups by team does not necessarily also split by skill level. A contest may have none.
  name      String
  sortOrder Int    @default(0)

  contest         Contest          @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestProblems ContestProblem[]
  participants    Participant[]
  standings       Standing[]
  problemSets     ProblemSet[]
  teams           Team[]

  @@unique([contestId, name])
  @@index([contestId])
}

// ---------------------------------------------------------------------------
// Problem bank
// ---------------------------------------------------------------------------

model Problem {
  id    String @id @default(cuid())
  /// Derived from the dedup key: `(title, language)` for CODINGBAT rows, `title` alone
  /// otherwise. See docs/DECISIONS.md D6 — keying warmups on title alone silently merges
  /// the Python and Java `sum67` into one problem.
  slug  String @unique
  title String

  /// Empty until an organizer writes an ORIGINAL statement. Never copied from HackerRank
  /// (PRD §8).
  statementMd String       @default("")
  inputSpec   String       @default("")
  outputSpec  String       @default("")
  constraints String       @default("")
  difficulty  Difficulty?
  /// A try-the-site question that lives in the practice arena. The contest line-up refuses it
  /// (API-level, like DRAFT): practice questions are public 365 days a year, and a public
  /// question in a scored round is a question somebody has already solved.
  practiceOnly Boolean @default(false)
  state       ProblemState @default(DRAFT)

  type       ProblemType
  pastStatus PastStatus?
  /// Set only for CODINGBAT warmups, which exist per-language.
  language   Language?

  timeLimitMs      Int        @default(2000)
  memoryLimitMb    Int        @default(256)
  /// Every runtime the judge can actually run, unless a problem narrows it deliberately.
  ///
  /// **This defaulted to `[PYTHON_312, JAVA_21]` and that was the wrong default.** The bank is
  /// seeded from `data/problems_seed.csv`, which names no languages, so 122 of the 130 problems
  /// took the default — and an organizer who built a contest out of the bank produced one where a
  /// student could not choose C, C++, JavaScript or Go, on any problem. The judge runs all ten
  /// variants and always did; the data said otherwise.
  ///
  /// A problem is stdin-to-stdout, so nothing about it is language-specific. The narrow case is a
  /// CODINGBAT warmup, which exists per language and carries `language` above — narrowing there is
  /// deliberate and set by the author, which is the point: **restriction should be a decision, not
  /// a default.**
  allowedLanguages Language[] @default([PYTHON_312, JAVA_8, JAVA_11, JAVA_17, JAVA_21, C_17, CPP_11, CPP_17, JAVASCRIPT_NODE22, GO_123])

  /// Used by the authoring flow to generate expected outputs. Must pass its own tests
  /// before the problem may leave DRAFT (PRD §9.2).
  referenceSolution String?
  /// Which runtime `referenceSolution` is written for. Null exactly when the reference is null.
  referenceLanguage Language?
  /// When the stored reference last passed EVERY test case through the real judge. Publishing
  /// requires this stamp; any edit to the reference, the test cases, the limits or the
  /// comparator clears it, because a validation of different inputs proves nothing about
  /// these. The seed importer stamps G13-verified content on import for the same reason G13
  /// exists: those references already passed the real judge.
  referenceValidatedAt DateTime?
  /// How the judge compares output for THIS problem: a `Comparator` from lib/schemas/judge
  /// (`{kind: "whitespace"}` and friends). Null means the default, whitespace, which forgives
  /// trailing spaces and line-ending differences; "exact" is opt-in for the rare problem where
  /// whitespace IS the answer (Staircase-shaped tasks still pass under whitespace because it
  /// preserves leading spaces).
  comparator Json?
  /// The function-signature declaration this problem's starter code is generated from, or NULL.
  ///
  /// Validated by `SignatureSchema` (lib/schemas/seed.ts) on the way in and on the way out —
  /// `Json` is `unknown` as far as Prisma is concerned, so it is a trust boundary in both
  /// directions, and a row written by an older build must be parsed rather than assumed.
  ///
  /// **NULL is the normal case and must stay working.** Most of the bank has no signature, and a
  /// problem without one behaves exactly as every problem did before this column existed: an
  /// empty editor and a raw stdin-to-stdout program. Nothing about judging, scoring or
  /// submission reads this field; it only decides what the editor is pre-filled with.
  ///
  /// Stored as the DECLARATION, not as the generated code. Six emitters times ten languages is
  /// derivable from it by a pure function, so storing the output would be a second source of
  /// truth that goes stale the moment an emitter is fixed.
  signature         Json?
  /// Notes the HackerRank inspiration for an imported title. Titles and history only.
  originAttribution String?
  /// Which round this problem is for. Replaces the boolean isGroupProblem, which could not
  /// express "individual, on a set" as distinct from "individual, no set".
  round             ProblemRound @default(INDIVIDUAL)
  isGroupProblem    Boolean      @default(false)
  tags              String[]     @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testCases       TestCase[]
  contestProblems ContestProblem[]

  @@index([state])
  @@index([type])
  @@index([pastStatus])
}

model TestCase {
  id        String @id @default(cuid())
  problemId String
  ordinal   Int

  /// Paths on disk, not blobs (PRD §5). Resolved relative to the test-data root so the
  /// DB stays cheap and large cases stream.
  inputPath          String
  expectedOutputPath String

  /// Sample tests may show a full diff to the student. Hidden tests return pass/fail and
  /// timing only, plus at most a 200-character truncated diff (PRD §7.2).
  isSample Boolean @default(false)
  /// Per-case points enable the partial-credit rule in PRD §6.1.
  points   Int     @default(0)
  /// Optional grouping label for all-or-nothing bundles of cases.
  group    String?

  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  testResults TestResult[]

  @@unique([problemId, ordinal])
  @@index([problemId])
}

/// Join of a Problem into a Contest at a given Division and slot. This is where a problem
/// used in both divisions at different difficulties lives as two rows over one Problem
/// (docs/DECISIONS.md D2).
model ContestProblem {
  id         String       @id @default(cuid())
  contestId  String
  problemId  String
  divisionId String?
  /// Whether this problem is worked by one assigned player or by the whole team in this contest.
  ///
  /// This belongs on the contest join rather than only on `Problem`: the same authored question
  /// may be an individual set question one night and a shared group question another night. Using
  /// the bank row made the organizer's Group selector cosmetic and could count one group answer
  /// once per teammate.
  round      ProblemRound @default(INDIVIDUAL)
  /// Which Round 1 set this problem belongs to. Null for a GROUP problem, which every team
  /// works regardless of set.
  setId      String?
  /// Human label for the slot, e.g. "A-E1" or "Group 1".
  slotLabel  String
  basePoints Int
  unlockAt   DateTime?

  /// True when the set planner dealt this row; false for a row an organizer placed by hand.
  ///
  /// Needed only for the GROUP round: the planner owns the whole INDIVIDUAL round (a re-plan
  /// replaces it wholesale), but group questions can come from two authors — the recipe's
  /// `setGroupCount` deal, and the Problems tab. A re-plan must replace the first without
  /// touching the second, and the rows are otherwise indistinguishable (round GROUP, setId null,
  /// divisionId null). Provenance in a column, not a slot-label naming convention, because a
  /// convention is one hand-typed label away from deleting an organizer's work.
  dealtByPlan Boolean @default(false)

  contest  Contest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem  Problem     @relation(fields: [problemId], references: [id], onDelete: Restrict)
  division Division?   @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  set      ProblemSet? @relation(fields: [setId], references: [id], onDelete: SetNull)

  submissions Submission[]
  hintGrants  HintGrant[]

  @@unique([contestId, problemId, divisionId])
  @@index([contestId])
  @@index([divisionId])
  @@index([setId])
}

// ---------------------------------------------------------------------------
// Participation
// ---------------------------------------------------------------------------

model Participant {
  id          String  @id @default(cuid())
  contestId   String
  /// Null when the participant joined by code with a display name only — the admin-issued
  /// fallback that must work when OAuth does not (PRD §10.1).
  userId      String?
  displayName String
  /// Optional. Teams replaced divisions as the primary ranking axis (PRD §5).
  divisionId  String?

  /// The team this participant competes for. **Team size is the divisor in the team score**, so
  /// a wrong roster is a wrong result rather than a cosmetic error.
  ///
  /// Nullable so a participant can exist before rosters are finalised; a participant with no team
  /// contributes to no team score, and the admin UI flags them.
  teamId String?

  /// The Round 1 problem set this player was assigned.
  ///
  /// Named `chosenSetId` because three formats are supported (Contest.setSelection) and only one
  /// is an actual choice. Under the default it is ASSIGNED — seeded, balanced, audit-logged — and
  /// the player never previews the alternatives (PRD §6.2).
  chosenSetId String?

  joinedAt DateTime @default(now())

  contest   Contest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  division  Division?   @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  team      Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  chosenSet ProblemSet? @relation(fields: [chosenSetId], references: [id], onDelete: SetNull)

  submissions Submission[]
  hintGrants  HintGrant[]
  standings   Standing[]
  sessions    Session[]

  @@unique([contestId, displayName])
  /// One signed-in account is one competitor in a contest, even if two callback requests race.
  /// Postgres permits multiple NULL userIds, so join-code/fallback participants remain valid.
  @@unique([contestId, userId])
  @@index([contestId])
  @@index([divisionId])
  @@index([teamId])
  @@index([chosenSetId])
}

// ---------------------------------------------------------------------------
// Submissions and judging
// ---------------------------------------------------------------------------

/// The submission log. lib/scoring/ replays this to produce standings; recomputing twice must be
/// byte-identical.
///
/// It is append-only for the JUDGE: nothing in the judging path ever rewrites a row, and
/// `reconcile` only writes to a submission that is still unjudged (or holds a transient `IE`).
///
/// The current verdict remains here for ordinary reads, but every change also appends a
/// `SubmissionScoreRevision`. That temporal log is what lets a frozen board recover the verdict
/// that was current at its cutoff after an organizer overrides or rejudges this row later.
/// `judgedAt` itself is never overwritten by an override: an override is not a judge run.
///
/// The consequence to know: after an override, `testResults` still describes the JUDGE's run and
/// will disagree with `verdict`. That is the honest state of affairs — the tests really did do
/// what they did — and it is why the override is audited rather than silent.
model Submission {
  id               String   @id @default(cuid())
  participantId    String
  contestProblemId String
  language         Language
  sourceCode       String
  submittedAt      DateTime @default(now())

  verdict     Verdict?
  /// Points awarded by the judge for this submission in isolation. The participant's
  /// score for a problem is the BEST across their submissions, computed in lib/scoring/.
  score       Int       @default(0)
  runtimeMs   Int?
  memoryKb    Int?
  judgedAt    DateTime?
  /// When this submission's CURRENT verdict and score became true.
  ///
  /// Distinct from `judgedAt`, which is when the JUDGE ran and never changes afterwards. An
  /// override moves `effectiveAt` and leaves `judgedAt` alone, so "what did the judge say, and
  /// when" stays answerable while the board still knows when the answer changed.
  ///
  /// This is what makes a freeze hold. The public board during a freeze shows the standings as
  /// they were at the freeze instant; filtering on `submittedAt` alone answered "which
  /// submissions existed yet", so a pre-freeze submission that was overridden or rejudged
  /// afterwards moved the frozen board. Measured: frozen with a student on 0, override to 140,
  /// and eighteen seconds later the anonymous board reported frozen:true, the same asOf, and 140.
  effectiveAt DateTime?
  /// Pointer to the structured judge log retained for dispute resolution (PRD §10).
  judgeLogRef String?
  /// Stage attribution for the judged run, so a slow submission names its own bucket
  /// (queue wait / container create / compile / run) instead of being guessed at.
  ///
  /// Shape: `JudgeTimingsSchema` in lib/schemas/judge.ts — epoch-anchored millisecond marks
  /// plus the BullMQ attempt number. Recorded by the worker, carried inside the BullMQ result,
  /// and persisted by `reconcile` — the worker itself still writes nothing to Postgres.
  /// Null for every submission judged before this column existed; readers treat absence
  /// as absence.
  judgeTimings Json?

  participant    Participant    @relation(fields: [participantId], references: [id], onDelete: Cascade)
  contestProblem ContestProblem @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
  scoreRevisions SubmissionScoreRevision[]
  testResults    TestResult[]

  @@index([participantId])
  @@index([contestProblemId])
  @@index([submittedAt])
  @@index([effectiveAt])
  @@index([verdict])
}

/// One version of a submission's score-bearing answer.
///
/// `Submission` is the current answer; this is the history. Rejudge appends a null-verdict
/// tombstone, and the next judge result appends a new answer. At a standings cutoff, the highest
/// revision id whose `effectiveAt` is inside the window is the answer that existed then.
model SubmissionScoreRevision {
  id           Int      @id @default(autoincrement())
  submissionId String
  verdict      Verdict?
  score        Int      @default(0)
  effectiveAt  DateTime

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, effectiveAt, id])
  @@index([effectiveAt])
}

model TestResult {
  id           String  @id @default(cuid())
  submissionId String
  testCaseId   String
  verdict      Verdict
  runtimeMs    Int?
  memoryKb     Int?
  /// Truncated. Never the full expected output — students reconstruct hidden cases by
  /// diffing (PRD §7.2). Enforced at the API edge as well as here.
  diffSnippet  String?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase   TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([submissionId, testCaseId])
  @@index([submissionId])
}

// ---------------------------------------------------------------------------
// Hints
// ---------------------------------------------------------------------------

/// Each hint taken on a group problem deducts 15% of that problem's base points. Hints are
/// earned at 2 CodingBat warmups = 1 hint, tracked here rather than on a clipboard
/// (PRD §6.1).
model HintGrant {
  id               String   @id @default(cuid())
  participantId    String
  contestProblemId String
  hintIndex        Int
  grantedAt        DateTime @default(now())
  /// Reference to the warmup solves that paid for this hint.
  costPaidRef      String?

  participant    Participant    @relation(fields: [participantId], references: [id], onDelete: Cascade)
  contestProblem ContestProblem @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)

  @@unique([participantId, contestProblemId, hintIndex])
  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Derived state
// ---------------------------------------------------------------------------

/// MATERIALIZED CACHE ONLY. Every column here is re-derivable by replaying Submission and
/// HintGrant through lib/scoring/. Truncating this table must never lose information. Do
/// not read it in a context that requires correctness over speed.
/// Materialized standings. **Team-ranked**, with a per-participant breakdown.
///
/// One row per team, plus one row per participant carrying that player's own contribution so the
/// UI can expand a team without recomputing. Both are derived from the submission log by
/// lib/scoring/ and can be thrown away and rebuilt at any time — nothing here is a source of
/// truth, which is what makes replay safe.
model Standing {
  id String @id @default(cuid())

  /// Set on a team row, null on a participant breakdown row.
  teamId        String?
  /// Set on a participant breakdown row, null on a team row.
  participantId String?
  divisionId    String?

  /// **Hundredths of a point**, not points.
  ///
  /// The team score is a mean, so fractional scores are normal (543.75 is a real result). Integer
  /// hundredths keep it exact; a float here would reintroduce the bug where 3 * 0.15 * 250 gave
  /// 112.49999999999999 and cost a student a point. See docs/SCORING.md §3.
  scoreHundredths    Int
  /// Team size at computation time — the divisor that produced scoreHundredths. Stored so a
  /// past result stays explainable after a roster change.
  teamSize           Int?
  /// Side activity points, flat, in whole points. Kept separate so the UI can show the
  /// arithmetic rather than just the total.
  sideActivityPoints Int  @default(0)

  penalty        Int
  lastAcceptedAt DateTime?
  rank           Int
  /// The scoring input this row was computed from, for staleness detection.
  computedAt     DateTime  @default(now())

  participant Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  division    Division?    @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, participantId])
  @@index([rank])
  @@index([divisionId, rank])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Every score change is written here so a disputed result can be explained (PRD §6.3).
/// Manual verdict overrides require a reason.
model AuditLog {
  id     String   @id @default(cuid())
  actor  String
  action String
  entity String
  before Json?
  after  Json?
  reason String?
  at     DateTime @default(now())

  @@index([entity])
  @@index([at])
}
